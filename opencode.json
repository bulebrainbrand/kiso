{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "*": "ask",
    "read": "allow",
    "edit": {
      "*": "ask",
      "packages/*/src/**/*": "allow"
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "cat *": "allow",
      "tail *": "allow",
      "echo *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "vp check *": "allow",
      "vp test *": "allow"
    },
    "todowrite": "allow",
    "grep": "allow",
    "external_directory": "ask",
    "glob": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  }
}
